Options -Indexes
DirectoryIndex public_html/index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^avaliar/([^/]+)/?$ public_html/index.php?route=avaliacao-publica/open&slug=$1 [L,QSA]
</IfModule>
